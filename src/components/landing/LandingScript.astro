---
// The ad landing pages' one script: Meta pixel (with the consent bar), and a pixel event
// + Press CTR beacon per button click carrying the page's utm_* unchanged. The buttons'
// Attribution tags are baked in at build, per (book, door); no ad changes them.
// Buttons are links with data-landing-cta="ku|buy|paperback" and, on a page with
// doors, data-landing-target="<door>" (sent with every event as `target`).
// The pixel and the beacon send only on the production hosts (site-config pixelHosts);
// anywhere else (localhost, a preview) each call is a `[pixel] …` console line instead.
import { missingLine, type MissingTag } from '../../utils/landing';

interface Props {
  /** The `page` parameter on every event, e.g. sophie-feegle-box-set */
  page: string;
  /** The buttons with no Attribution tag (they link to the bare product page). */
  missingTags: MissingTag[];
  pixelId?: string;
  /** Hostnames the pixel and beacon send from, e.g. gwendemarco.com, www.gwendemarco.com */
  pixelHosts?: string[];
  ctrEndpoint?: string;
}

const { page, missingTags, pixelId, pixelHosts, ctrEndpoint } = Astro.props;
// The build says which buttons go untagged, so a new book's missing tags are seen.
if (missingTags.length) console.warn(`[attribution] missing on ${page}: ${missingLine(missingTags)}`);
const landingConfig = {
  page,
  missingTags,
  pixelId: pixelId?.trim() || '',
  pixelHosts: (pixelHosts ?? []).map((host) => host.trim().toLowerCase()).filter(Boolean),
  ctrEndpoint: ctrEndpoint?.trim() || '',
};
---

<script is:inline define:vars={{ landingConfig }}>
  (function () {
    var EVENTS = { ku: 'LandingClickKU', buy: 'LandingClickBuy', paperback: 'LandingClickPaperback' };
    var CONSENT_KEY = 'gd_marketing_consent';
    var AD_KEY = 'gd_landing_from_ad';
    var UTM_KEY = 'gd_landing_utm';
    // IANA zones for the 50 states and DC; the site is static, so the browser's
    // time zone is our region signal.
    var US_ZONE = /^(America\/(New_York|Detroit|Kentucky\/.+|Indiana\/.+|Chicago|Menominee|North_Dakota\/.+|Denver|Boise|Phoenix|Los_Angeles|Anchorage|Juneau|Sitka|Metlakatla|Yakutat|Nome|Adak)|Pacific\/Honolulu|US\/.+)$/;

    // Ad visitor: ?from=ad or utm_source=meta, remembered for the tab session. Only
    // labels the click events' source; the Attribution tags are on every link.
    var params = new URLSearchParams(location.search);
    var fromAd = params.get('from') === 'ad' || (params.get('utm_source') || '').toLowerCase() === 'meta';
    try {
      if (fromAd) sessionStorage.setItem(AD_KEY, '1');
      else fromAd = sessionStorage.getItem(AD_KEY) === '1';
    } catch (e) {}

    // The page's utm_* (which ad sent the visitor), remembered for the tab session and
    // passed through unchanged on every click event; utm_campaign also rides as `campaign`.
    var utm = {};
    params.forEach(function (value, key) {
      if (/^utm_/.test(key)) utm[key] = value;
    });
    try {
      if (Object.keys(utm).length) sessionStorage.setItem(UTM_KEY, JSON.stringify(utm));
      else utm = JSON.parse(sessionStorage.getItem(UTM_KEY) || '{}') || {};
    } catch (e) {}
    var campaign = utm.utm_campaign || '';

    var ctas = document.querySelectorAll('[data-landing-cta]');

    // Production host only: anywhere else the same calls are console lines, nothing sent.
    var live = landingConfig.pixelHosts.indexOf(location.hostname.toLowerCase()) !== -1;
    function pixel(method, name, data) {
      if (live) fbq(method, name, data);
      else console.log('[pixel] ' + name + ' ' + JSON.stringify(data));
    }

    // Meta pixel: US visitors without a click, everyone else after "Allow".
    var pixelLoaded = false;
    function loadPixel() {
      if (pixelLoaded || !landingConfig.pixelId) return;
      pixelLoaded = true;
      if (!live) {
        pixel('track', 'PageView', campaign ? { campaign: campaign } : {});
        return;
      }
      !function(f,b,e,v,n,t,s)
      {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
      n.callMethod.apply(n,arguments):n.queue.push(arguments)};
      if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
      n.queue=[];t=b.createElement(e);t.async=!0;
      t.src=v;s=b.getElementsByTagName(e)[0];
      s.parentNode.insertBefore(t,s)}(window,document,'script',
      'https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', landingConfig.pixelId);
      pixel('track', 'PageView', campaign ? { campaign: campaign } : {});
    }

    var zone = '';
    try { zone = Intl.DateTimeFormat().resolvedOptions().timeZone || ''; } catch (e) {}
    var stored = null;
    try { stored = localStorage.getItem(CONSENT_KEY); } catch (e) {}

    if (stored !== 'denied' && (US_ZONE.test(zone) || stored === 'granted')) {
      loadPixel();
    } else if (stored !== 'denied' && landingConfig.pixelId) {
      var consentBar = document.getElementById('consent-bar');
      consentBar.hidden = false;
      consentBar.addEventListener('click', function (e) {
        var choice = e.target.closest('[data-consent]');
        if (!choice) return;
        try { localStorage.setItem(CONSENT_KEY, choice.dataset.consent); } catch (err) {}
        consentBar.hidden = true;
        if (choice.dataset.consent === 'granted') loadPixel();
      });
    }

    // press.landing.ctr: custom pixel event per button, plus a keepalive beacon
    // once the Press endpoint exists.
    ctas.forEach(function (a) {
      a.addEventListener('click', function () {
        var cta = a.dataset.landingCta;
        var detail = { page: landingConfig.page, cta: cta, source: fromAd ? 'ad' : 'organic', campaign: campaign };
        if (a.dataset.landingTarget) detail.target = a.dataset.landingTarget;
        Object.keys(utm).forEach(function (key) { detail[key] = utm[key]; });
        if (pixelLoaded) pixel('trackCustom', EVENTS[cta], detail);
        if (landingConfig.ctrEndpoint && !live) {
          console.log('[pixel] beacon ' + JSON.stringify(Object.assign({ metric: 'press.landing.ctr' }, detail)));
        } else if (landingConfig.ctrEndpoint) {
          try {
            fetch(landingConfig.ctrEndpoint, {
              method: 'POST',
              keepalive: true,
              // text/plain keeps this a simple request (no CORS preflight).
              headers: { 'Content-Type': 'text/plain' },
              body: JSON.stringify(Object.assign({ metric: 'press.landing.ctr' }, detail)),
            }).catch(function () {});
          } catch (e) {}
        }
      });
    });

    // Phone: slide the sticky bar (if the page has one) away while the closing pair is on screen.
    var bar = document.getElementById('cta-bar');
    var closing = document.getElementById('closing-ctas');
    if (bar && closing && 'IntersectionObserver' in window) {
      new IntersectionObserver(function (entries) {
        bar.classList.toggle('translate-y-full', entries[0].isIntersecting);
      }).observe(closing);
    }
  })();
</script>
