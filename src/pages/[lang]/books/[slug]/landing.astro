---
// A book's landing page in German and French: built for every book with a `landing:`
// block and an edition with a blurb in the language (editions.<lang>); the build says which
// it skipped and why.
import { type CollectionEntry, getCollection } from 'astro:content';
import BookLandingPage from '../../../../components/landing/BookLandingPage.astro';
import { editionOf, landingEditionOf } from '../../../../utils/editions';
import { LANDING_LANGS, type LandingLang } from '../../../../utils/landing';

export async function getStaticPaths() {
  const books = (await getCollection('books')).filter((book) => book.data.landing);
  return LANDING_LANGS.flatMap((lang) =>
    books
      .filter((book) => {
        if (landingEditionOf(book, lang)) return true;
        const why = editionOf('books', book, lang) ? `its ${lang} edition has no blurb` : `${book.id} has no ${lang} edition`;
        console.warn(`[landing] not built: /${lang}/books/${book.id}/landing/ (${why})`);
        return false;
      })
      .map((book) => ({ params: { lang, slug: book.id }, props: { book } })),
  );
}

interface Props {
  book: CollectionEntry<'books'>;
}

const { book } = Astro.props;
const { lang } = Astro.params as { lang: LandingLang };
---

<BookLandingPage book={book} lang={lang} />
