---
// Sophie Feegle box-set landing page: where readers land from the Meta ad.
// CMS inputs (all optional, see README "Box-set landing page"):
//   series boxSetAsin / boxSetSlug / boxSetBlurb / boxSetPrice / boxSetSeparatePrice, and
//   site-config metaPixelId / attributionTags / pressCtrEndpoint / amazonBadge
import Layout from '../../../layouts/Layout.astro';
import StarRating from '../../../components/StarRating.astro';
import ConsentBar from '../../../components/landing/ConsentBar.astro';
import LandingScript from '../../../components/landing/LandingScript.astro';
import { getCollection, getEntry } from 'astro:content';
import { doorLinks, landingImage, money, toReview as findReview } from '../../../utils/landing';

const SERIES_SLUG = 'sophie-feegle';
// Short, whole Amazon reviews: the pull-quote under the hero, then four lower down.
// Placeholders until the box-set review quotes land on signals #2684.
const PULL_QUOTE_ID = '2024-04-11-map-verified-false-featured-false-date-2024-04-11-booktitle-odd-times-for-sophie-feegle-reviewername-mrs-dustbunny-reviewerplatform-amazon-quote-holy-wow-nan-amazing-storyline-with-enough-twist-to-make-your-head-spin';
// Each names something specific; four different books. `excerpt` replaces a long
// review's body, with an ellipsis wherever text is cut.
const REVIEWS: { id: string; excerpt?: string }[] = [
  {
    id: '2023-10-07-map-verified-false-featured-false-date-2023-10-07-booktitle-odds-and-ends-reviewername-bglanton-reviewerplatform-amazon-quote-absolutely-love-this-series-nits-an-absolute-joy-to-read-these-books-they-have-twists',
    excerpt: 'It’s an absolute joy to read these books. They have twists, revelations, the whole nine yards. … The familiar tropes are dusted off and spun in new and interesting directions. Highly recommended.',
  },
  { id: '2024-12-28-map-verified-false-featured-false-date-2024-12-28-booktitle-sophie-and-the-odd-ones-reviewername-anne-reviewerplatform-amazon-quote-thoroughly-enjoyable-ngreat-plot-great-pacing-well-developed-and-believable-charact' },
  {
    id: '2024-04-17-map-verified-false-featured-false-date-2024-04-17-booktitle-sophie-feegle-box-set-reviewername-rhonda-jones-reviewerplatform-amazon-quote-awesome-nthis-series-has-a-great-cast-of-characters-each-book-takes-up-after-t',
    excerpt: '… It starts with a human woman (Sophie) who is down on her luck, but due to an act of kindness, gets a job as a coroner’s assistant. There she learns she has an unusual gift. When she touches a corpse she can see how that person died. … Book 5 had an absolutely awesome ending!!!',
  },
  { id: '2021-12-28-map-verified-false-featured-false-date-2021-12-28-booktitle-portents-and-oddities-reviewername-lastenia-s-reviewerplatform-amazon-quote-excellent-series-nthis-author-is-new-to-me-and-quickly-becoming-a-favorite-the' },
];
// One line under each cover, lifted from each book's page. Keep them short enough
// not to wrap at phone width.
const BOOK_HOOKS: Record<string, string> = {
  'sophie-and-the-odd-ones': 'Her calling: the morgue’s graveyard shift.',
  'portents-and-oddities': 'She gets visions of the victims’ deaths.',
  'odd-times-for-sophie-feegle': 'Murders in a mythical-run town.',
  'against-all-odds': 'Undercover at a Vegas shifter fight club.',
  'odds-and-ends': 'The finale: who Sophie truly is.',
};
// Book 1 in paperback: a quiet link that measures interest in print.
const PAPERBACK_URL = 'https://www.amazon.com/dp/B08CWM839H';
const BLURB_PARAGRAPHS = 3;

const series = await getEntry('series', SERIES_SLUG);
if (!series) throw new Error(`Missing series entry: ${SERIES_SLUG}`);

const readingOrder = series.data.readingOrder ?? [];
const allBooks = await getCollection('books');
const books = readingOrder
  .map((slug) => allBooks.find((book) => book.id === slug))
  .filter((book): book is NonNullable<typeof book> => Boolean(book));

const testimonials = await getCollection('testimonials');
const toReview = (id: string, excerpt?: string) => {
  const review = findReview(testimonials, id, excerpt);
  if (!review) return undefined;
  const book = books.find((b) => b.id === review.bookId);
  return { ...review, about: book ? book.data.title : 'the Sophie Feegle Box Set' };
};
const pullQuote = toReview(PULL_QUOTE_ID);
const reviews = REVIEWS.map((r) => toReview(r.id, r.excerpt)).filter((r): r is NonNullable<typeof r> => Boolean(r));

// Series-wide numbers, labelled as such: the box set has its own (smaller) Amazon rating.
const rating = series.data.overallRating;
const ratingCount = series.data.totalRatings;
const showRating = rating > 0 && ratingCount > 0;

const siteConfig = await getEntry('settings', 'site-config');
const amazonBadge = siteConfig?.data.amazonBadge?.trim();

// Amazon Attribution, per (product, door) whatever ad sent the visitor: KU and Kindle
// take the box set's tags, the paperback link book one's Print tag. A tag may be the
// whole Attribution URL; only its query string is used. No tag: the bare /dp link.
const asin = series.data.boxSetAsin?.trim();
const amazonBase = asin
  ? `https://www.amazon.com/dp/${asin}`
  : 'https://www.amazon.com/s?k=Sophie+Feegle+Box+Set+Gwen+DeMarco&i=digital-text';
const { links, missing: missingTags } = doorLinks(
  {
    target: '',
    kindleUrl: amazonBase,
    paperbackUrl: PAPERBACK_URL,
    product: series.data.boxSetSlug?.trim() || `${SERIES_SLUG}-box-set`,
    printProduct: readingOrder[0] ?? '',
  },
  siteConfig?.data.attributionTags,
);

const price = money(series.data.boxSetPrice);
const separatePrice = money(series.data.boxSetSeparatePrice);
const buyLabel = price ? `Buy the Kindle box set — ${price}` : 'Buy the Kindle box set';
const valueLine = price && separatePrice ? `${books.length} books for ${price} — ${separatePrice} bought separately` : '';

// The full blurb stays on Amazon; the page carries the first three paragraphs.
const pitch = (series.data.boxSetBlurb?.trim() || series.data.description)
  .split(/\n\s*\n/)
  .map((p) => p.trim())
  .filter(Boolean)
  .slice(0, BLURB_PARAGRAPHS);
---

<Layout
  title="The Sophie Feegle Box Set: All Five Books | Gwen DeMarco"
  description="All five Sophie Feegle urban fantasy novels in one box set. Snarky heroines. Grumpy heroes. Found family. Free for Kindle Unlimited members."
  image={`/images/landing/${SERIES_SLUG}-box-set-og.jpg`}
  landing
>
  <main id="main-content" class="relative z-10 pt-8 pb-12 lg:pt-12 lg:pb-16">
    <ConsentBar />

    <div class="max-w-6xl mx-auto px-4 grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_23rem] gap-10 items-start">
      <div>
        <!-- Hero: box set, hook, tropes, rating, pull-quote -->
        <section class="grid sm:grid-cols-[minmax(0,14rem)_1fr] gap-6 sm:gap-8 items-center">
          <img
            src={landingImage(series.data.cover ?? '/images/boxset.png', 640, 'webp')}
            alt="Sophie Feegle Box Set, Books 1–5 by Gwen DeMarco"
            width="640"
            height="658"
            class="w-full max-w-[13rem] sm:max-w-none mx-auto drop-shadow-[0_20px_35px_rgba(107,70,193,0.35)]"
            fetchpriority="high"
          />
          <div class="text-center sm:text-left">
            <p class="text-mystic-teal font-medium uppercase tracking-widest text-sm mb-2">The complete series · {books.length} books</p>
            <h1 class="text-3xl md:text-5xl font-primary font-bold text-bone-white mb-3">The Sophie Feegle Box Set</h1>
            <p class="text-lg md:text-xl text-moon-silver mb-2">
              The dead keep their secrets at the San Francisco City Morgue. Until Sophie touches them.
            </p>
            <p class="text-ember-orange font-medium mb-4">Snarky heroines. Grumpy heroes. Found family.</p>
            {showRating && (
              <div class="text-moon-silver">
                <div class="flex items-center justify-center sm:justify-start gap-2">
                  <StarRating rating={rating} id="box-set-hero" />
                  <span>{rating.toFixed(1)} average across the series</span>
                </div>
                <p class="text-sm text-fog-gray mt-1">{ratingCount.toLocaleString('en-US')} ratings across all {books.length} books</p>
              </div>
            )}
          </div>
        </section>

        {pullQuote && (
          <figure class="mt-8 border-l-4 border-ember-orange pl-5">
            <blockquote>
              <p class="font-primary text-2xl text-bone-white mb-2">“{pullQuote.title}”</p>
              <p class="text-moon-silver">{pullQuote.body}</p>
            </blockquote>
            <figcaption class="mt-2 text-sm text-fog-gray">{pullQuote.reviewer}, Amazon review of {pullQuote.about}</figcaption>
          </figure>
        )}

        <!-- Covers in series order, one hook line each -->
        <section class="mt-12">
          <h2 class="text-2xl md:text-3xl font-primary font-bold text-bone-white mb-6">All five books inside</h2>
          <ol class="space-y-4">
            {books.map((book) => (
              <li class="flex items-center gap-3 sm:gap-4">
                {book.data.cover && (
                  <img
                    src={landingImage(book.data.cover, 400)}
                    alt={`${book.data.title} cover`}
                    width="400"
                    height="600"
                    loading="lazy"
                    decoding="async"
                    class="w-14 sm:w-20 shrink-0 rounded-md shadow-lg shadow-mystic-violet/20 aspect-[2/3] object-cover"
                  />
                )}
                <div class="min-w-0">
                  <p class="text-xs text-mystic-teal">Book {book.data.seriesOrder}</p>
                  <p class="font-medium text-bone-white leading-tight">{book.data.title}</p>
                  {BOOK_HOOKS[book.id] && (
                    <p class="text-sm text-moon-silver mt-1 whitespace-nowrap">{BOOK_HOOKS[book.id]}</p>
                  )}
                </div>
              </li>
            ))}
          </ol>
        </section>

        <!-- Pitch -->
        <section class="mt-12 prose prose-lg max-w-none">
          {pitch.map((paragraph) => <p>{paragraph}</p>)}
        </section>

        <!-- Reviews (text only, attributed), two by two -->
        {reviews.length > 0 && (
          <section class="mt-12">
            <h2 class="text-2xl md:text-3xl font-primary font-bold text-bone-white mb-6">What readers say on Amazon</h2>
            <div class="grid md:grid-cols-2 gap-6">
              {reviews.map((review) => (
                <figure class="rounded-lg border border-mystic-violet/20 bg-dark-surface/60 p-6 flex flex-col">
                  <blockquote class="flex-1">
                    {review.title && <p class="font-primary text-lg text-bone-white mb-2">“{review.title}”</p>}
                    <p class="text-moon-silver">{review.body}</p>
                  </blockquote>
                  <figcaption class="mt-4 text-sm text-fog-gray">{review.reviewer}, Amazon review of {review.about}</figcaption>
                </figure>
              ))}
            </div>
          </section>
        )}

        <!-- Closing line; on phones the last pair of buttons follows it (at desktop the sidebar is the pair) -->
        <section id="closing-ctas" class="mt-12 text-center lg:text-left">
          <p class="font-primary text-xl md:text-2xl text-bone-white mb-6">
            Snarky heroines. Grumpy heroes. Found family. All five books, one click.
          </p>
          <div class="lg:hidden max-w-md mx-auto">
            <a href={links.ku} data-landing-cta="ku" class="btn btn-primary btn-lg w-full">
              Read free with Kindle Unlimited
            </a>
            <p class="text-sm text-fog-gray text-center mt-1 mb-3">Free for Kindle Unlimited members</p>
            <a href={links.buy} data-landing-cta="buy" class="btn btn-secondary btn-lg w-full">
              {buyLabel}
            </a>
            {valueLine && <p class="text-sm text-fog-gray text-center mt-1">{valueLine}</p>}
            <p class="text-center mt-4">
              <a href={links.paperback} data-landing-cta="paperback" class="text-sm text-fog-gray underline underline-offset-2 hover:text-moon-silver">Prefer paper? Book 1 in paperback →</a>
            </p>
          </div>
        </section>
      </div>

      <!-- Box-set sidebar: rating and the buttons, always on screen at desktop widths -->
      <aside class="hidden lg:block lg:sticky lg:top-8">
        <div class="card p-6">
          {showRating && (
            <div class="mb-6 text-sm">
              <p class="flex items-center gap-1.5 text-moon-silver font-medium">
                <StarRating rating={rating} size="w-3.5 h-3.5" id="box-set-sidebar" />
                {rating.toFixed(1)} average across the series
              </p>
              <p class="text-xs text-fog-gray mt-1">{ratingCount.toLocaleString('en-US')} ratings across all {books.length} books</p>
            </div>
          )}
          <a href={links.ku} data-landing-cta="ku" class="btn btn-primary btn-lg w-full !text-base !px-4">
            Read free with Kindle Unlimited
          </a>
          <p class="text-sm text-fog-gray text-center mt-1 mb-4">Free for Kindle Unlimited members</p>
          <a href={links.buy} data-landing-cta="buy" class="btn btn-secondary btn-lg w-full !text-base !px-4">
            {buyLabel}
          </a>
          {valueLine && <p class="text-sm text-fog-gray text-center mt-1">{valueLine}</p>}
          <p class="text-center mt-4">
            <a href={links.paperback} data-landing-cta="paperback" class="text-sm text-fog-gray underline underline-offset-2 hover:text-moon-silver">Prefer paper? Book 1 in paperback →</a>
          </p>
          {amazonBadge && (
            <img src={amazonBadge} alt="Available at Amazon" class="h-10 w-auto mx-auto mt-5" loading="lazy" />
          )}
        </div>
      </aside>
    </div>

    <!-- Phone: the buttons in a bar fixed to the screen bottom; it slides away while the closing pair is in view -->
    <div id="cta-bar" class="lg:hidden fixed inset-x-0 bottom-0 z-40 border-t border-mystic-violet/30 bg-shadow-black/95 backdrop-blur px-4 pt-3 pb-[max(0.75rem,env(safe-area-inset-bottom))] transition-transform duration-200">
      <div class="max-w-md mx-auto">
        <a href={links.ku} data-landing-cta="ku" class="btn btn-primary btn-lg w-full">
          Read free with Kindle Unlimited
        </a>
        <p class="text-xs text-fog-gray text-center mt-1 mb-2">Free for Kindle Unlimited members</p>
        <a href={links.buy} data-landing-cta="buy" class="btn btn-secondary btn-lg w-full">
          {buyLabel}
        </a>
        {valueLine && <p class="text-xs text-fog-gray text-center mt-1">{valueLine}</p>}
      </div>
    </div>
  </main>

  <LandingScript
    page="sophie-feegle-box-set"
    missingTags={missingTags}
    pixelId={siteConfig?.data.metaPixelId}
    pixelHosts={siteConfig?.data.pixelHosts}
    ctrEndpoint={siteConfig?.data.pressCtrEndpoint}
  />
</Layout>
