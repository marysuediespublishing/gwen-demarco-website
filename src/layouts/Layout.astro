---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FogBackground from '../components/ui/FogBackground';
import NewsletterCTA from '../components/ui/NewsletterCTA';

export interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: string;
  /** Ad landing pages: name mark and legal links only, so the page has one exit. */
  landing?: boolean;
}

const {
  title,
  description = "Gwen DeMarco writes paranormal romance with a focus on the weird and wonderful. Snarky heroines, grumpy heroes, and found family.",
  image,
  type = "website",
  landing = false
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImageURL = image ? new URL(image, Astro.url) : undefined;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#0a0a0f" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {socialImageURL && <meta property="og:image" content={socialImageURL} />}
    <meta property="og:site_name" content="Gwen DeMarco - Paranormal Romance Author" />

    <!-- Twitter -->
    <meta property="twitter:card" content={socialImageURL ? "summary_large_image" : "summary"} />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    {socialImageURL && <meta property="twitter:image" content={socialImageURL} />}

    <!-- Additional SEO -->
    <meta name="robots" content="index, follow" />
    <meta name="author" content="Gwen DeMarco" />
    <meta name="keywords" content="paranormal romance, urban fantasy, shifter romance, vampire romance, gwen demarco, sophie feegle" />

    <!-- Performance optimizations -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <title>{title}</title>
  </head>
  <body class="min-h-screen antialiased bg-shadow-black text-moon-silver">
    <!-- Subtle animated fog background for atmosphere -->
    <FogBackground client:load fogLayerCount={5} emberCount={12} className="opacity-50" />

    <!-- Skip to main content for accessibility -->
    <a href="#main-content" class="skip-link">
      Skip to main content
    </a>

    {landing ? (
      <header class="bg-gradient-to-r from-shadow-black to-midnight-purple border-b border-mystic-violet/20">
        <div class="container mx-auto px-4 py-3">
          <a href="/" class="inline-flex items-center space-x-2 min-h-[44px]">
            <span class="w-8 h-8 bg-gradient-to-br from-mystic-violet to-ember-orange rounded-full flex items-center justify-center shadow-mystic">
              <span class="text-bone-white font-bold font-accent text-sm">GD</span>
            </span>
            <span class="text-xl font-bold font-primary text-bone-white">Gwen DeMarco</span>
          </a>
        </div>
      </header>
    ) : (
      <Header />
    )}

    <slot />

    {landing ? (
      <footer class="relative z-10 border-t border-mystic-violet/20 py-6 text-sm text-moon-silver/60">
        <p class="container mx-auto px-4 text-center">
          <a href="/privacy-policy" class="hover:text-ember-orange transition-colors">Privacy</a>
          <span aria-hidden="true" class="mx-2">·</span>
          <a href="/cookie-policy" class="hover:text-ember-orange transition-colors">Cookies</a>
          <span aria-hidden="true" class="mx-2">·</span>
          <a href="/contact" class="hover:text-ember-orange transition-colors">Contact</a>
        </p>
      </footer>
    ) : (
      <>
        <Footer />

        <!-- Global newsletter signup modal (triggered via custom event) -->
        <NewsletterCTA client:load />
      </>
    )}

    <!-- Global scripts -->
    <script is:inline>
      // Enhanced focus management
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Tab') {
          document.body.classList.add('user-is-tabbing');
        }
      });

      document.addEventListener('mousedown', () => {
        document.body.classList.remove('user-is-tabbing');
      });

      // Wire up all .newsletter-trigger buttons to open the newsletter modal
      document.addEventListener('click', (e) => {
        if (e.target.closest('.newsletter-trigger')) {
          e.preventDefault();
          document.dispatchEvent(new CustomEvent('open-newsletter-modal'));
        }
      });
    </script>
  </body>
</html>
